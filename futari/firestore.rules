rules_version = '2';
// ウリログ：Firestoreのセキュリティルール
// ・自分のプロフィールは本人だけ
// ・ルームとおでかけ候補は、ルームのメンバー（最大2人）だけ
// ・参加できるのは、メンバーが登録した「恋人のメールアドレス」でログインした人だけ（1人まで）
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function myEmail() { return request.auth.token.email; }
    function isMember(roomId) {
      return signedIn() && uid() in get(/databases/$(database)/documents/rooms/$(roomId)).data.members;
    }

    match /users/{userId} {
      allow read, write: if signedIn() && uid() == userId;
    }

    // 招待状：ドキュメント名は招待された人のメールアドレス
    match /invites/{email} {
      allow get: if signedIn() && myEmail() == email;
      allow list: if false;
      allow delete: if signedIn() && (myEmail() == email || isMember(resource.data.roomId));
      allow create: if signedIn()
        && request.resource.data.roomId is string
        && isMember(request.resource.data.roomId)
        && getAfter(/databases/$(database)/documents/rooms/$(request.resource.data.roomId)).data.partnerEmail == email;
      allow update: if signedIn()
        && isMember(resource.data.roomId)
        && request.resource.data.roomId == resource.data.roomId
        && getAfter(/databases/$(database)/documents/rooms/$(request.resource.data.roomId)).data.partnerEmail == email;
    }

    match /rooms/{roomId} {
      allow get: if signedIn() && uid() in resource.data.members;
      allow list, delete: if false;

      allow create: if signedIn()
        && request.resource.data.ownerUid == uid()
        && request.resource.data.members == [uid()]
        && request.resource.data.names.keys().hasOnly([uid()]);

      allow update: if signedIn() && (
        // メンバーの変更（名前・恋人のメールアドレス・自分が抜ける）
        (uid() in resource.data.members
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'names', 'partnerEmail', 'members', 'since', 'annivs'])
          && (request.resource.data.members == resource.data.members
              || request.resource.data.members == resource.data.members.removeAll([uid()]))
          && request.resource.data.names.diff(resource.data.names).affectedKeys().hasOnly([uid()]))
        ||
        // 登録されたメールアドレスの人が参加（ルームが1人のときだけ、自分を1人追加）
        (!(uid() in resource.data.members)
          && resource.data.members.size() == 1
          && resource.data.partnerEmail is string
          && resource.data.partnerEmail.size() > 3
          && myEmail() == resource.data.partnerEmail
          && request.resource.data.members == resource.data.members.concat([uid()])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'names'])
          && request.resource.data.names.diff(resource.data.names).affectedKeys().hasOnly([uid()]))
      );

      // 思い出の写真（大きいほう）。候補と同じく、ふたりだけ
      match /photos/{placeId} {
        allow read, delete: if isMember(roomId);
        allow create, update: if isMember(roomId)
          && request.resource.data.img is string
          && request.resource.data.img.size() < 1000000;
      }

      // デートの予定。ふたりだけ
      match /dates/{dateId} {
        allow read, delete: if isMember(roomId);
        allow create, update: if isMember(roomId)
          && request.resource.data.date is string
          && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 100;
      }

      // つぶやき（廃止）。残っている古いデータを消すためだけに、読むのと消すのを許可
      match /posts/{postId} {
        allow read, delete: if isMember(roomId);
      }
      match /postPhotos/{postId} {
        allow read, delete: if isMember(roomId);
      }

      // 今日の質問の答え。ふたりだけ
      match /qa/{day} {
        allow read, write: if isMember(roomId);
      }

      // お願いチケット。ふたりだけ
      match /tickets/{ticketId} {
        allow read, write: if isMember(roomId);
      }

      // 相性テストの答え。ふたりだけ
      match /quiz/{setId} {
        allow read, write: if isMember(roomId);
      }

      match /places/{placeId} {
        allow read, delete: if isMember(roomId);
        allow create, update: if isMember(roomId)
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 100;
      }
    }
  }
}
