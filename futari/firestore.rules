rules_version = '2';
// ふたり日和：Firestoreのセキュリティルール
// ・自分のプロフィールは本人だけ
// ・ルームとおでかけ候補は、ルームのメンバー（最大2人）だけ
// ・参加は「招待URLの鍵」を知っている人だけ、1人まで
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function isMember(roomId) {
      return signedIn() && uid() in get(/databases/$(database)/documents/rooms/$(roomId)).data.members;
    }

    match /users/{userId} {
      allow read, write: if signedIn() && uid() == userId;
    }

    match /rooms/{roomId} {
      allow get: if signedIn() && uid() in resource.data.members;
      allow list, delete: if false;

      allow create: if signedIn()
        && request.resource.data.ownerUid == uid()
        && request.resource.data.members == [uid()]
        && request.resource.data.names.keys().hasOnly([uid()])
        && request.resource.data.inviteKey is string
        && request.resource.data.inviteKey.size() >= 16;

      allow update: if signedIn() && (
        // メンバーの変更（名前・招待URLの作り直し・自分が抜ける）
        (uid() in resource.data.members
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'names', 'inviteKey', 'members'])
          && (request.resource.data.members == resource.data.members
              || request.resource.data.members == resource.data.members.removeAll([uid()]))
          && request.resource.data.names.diff(resource.data.names).affectedKeys().hasOnly([uid()])
          && request.resource.data.inviteKey is string
          && request.resource.data.inviteKey.size() >= 16)
        ||
        // 招待URLで参加（ルームが1人のときだけ、自分を1人追加）
        (!(uid() in resource.data.members)
          && resource.data.members.size() == 1
          && resource.data.inviteKey is string
          && resource.data.inviteKey.size() >= 16
          && request.resource.data.joinKey == resource.data.inviteKey
          && request.resource.data.members == resource.data.members.concat([uid()])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'names', 'joinKey'])
          && request.resource.data.names.diff(resource.data.names).affectedKeys().hasOnly([uid()]))
      );

      match /places/{placeId} {
        allow read, delete: if isMember(roomId);
        allow create, update: if isMember(roomId)
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 100;
      }
    }
  }
}
